#!/usr/bin/env bash
# Launch FuseViewer: load FUSE + the JSONs in the data directory above this
# script, open the GUI, and drop to a Julia REPL alongside the window.
#
# Usage:   ./fuseviewer/run               # uses the dir containing fuseviewer/
#          ./fuseviewer/run /path/to/dir  # override the data directory

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATA_DIR="${1:-$(dirname "$SCRIPT_DIR")}"

cd "$DATA_DIR"
exec julia --project=@v1.11 "$SCRIPT_DIR/setup.jl"
